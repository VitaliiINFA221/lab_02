<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE martif SYSTEM "TBXcoreStructV02.dtd">
<martif type="TBX" xml:lang="en">
  <martifHeader>
    <fileDesc>
      <titleStmt>
        <title>Glossary EN-RU: Кибербезопасность и защита информации</title>
      </titleStmt>
      <sourceDesc>
        <p>Lab 01, variant 2, ISO 27000 + GOST 33707</p>
      </sourceDesc>
    </fileDesc>
    <encodingDesc>
      <p type="XCSURI">TBXXCSV02.xcs</p>
    </encodingDesc>
  </martifHeader>
  <text>
    <body>
      <termEntry id="tid-001">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>access control</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">means to ensure that access to assets is authorized and restricted based on business and security requirements</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>управление доступом</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-002">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>attack</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">attempt to destroy, expose, alter, disable, steal or gain unauthorized access to or make unauthorized use of an asset</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>атака</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-003">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>audit</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">systematic, independent and documented process for obtaining audit evidence and evaluating it objectively to determine the extent to which the audit criteria are fulfilled</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>аудит</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-004">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>audit scope</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">extent and boundaries of an audit</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>область аудита</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-005">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>authentication</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">provision of assurance that a claimed characteristic of an entity is correct</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>аутентификация</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-006">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>authenticity</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">property that an entity is what it claims to be</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>подлинность</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-007">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>availability</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">property of being accessible and usable on demand by an authorized entity</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>доступность</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-008">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>base measure</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">measure defined in terms of an attribute and the method for quantifying it</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>основной показатель</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-009">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>competence</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">ability to apply knowledge and skills to achieve intended results</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>компетентность</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-010">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>confidentiality</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">property that information is not made available or disclosed to unauthorized individuals, entities, or processes</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>конфиденциальность</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-011">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>conformity</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">fulfilment of a requirement</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>соответствие</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-012">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>consequence</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">outcome of an event affecting objectives</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>последствие</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-013">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>continual improvement</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">recurring activity to enhance performance</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>постоянное улучшение</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-014">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>control</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">measure that is modifying risk</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>средство управления</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-015">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>control objective</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">statement describing what is to be achieved as a result of implementing controls</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>цель управления</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-016">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>correction</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">action to eliminate a detected nonconformity</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>коррекция</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-017">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>corrective action</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">action to eliminate the cause of a nonconformity and to prevent recurrence</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>корректирующее действие</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-018">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>derived measure</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">measure that is defined as a function of two or more values of base measures</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>производный показатель</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-019">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>documented information</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">information required to be controlled and maintained by an organization and the medium on which it is contained</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>документированная информация</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-020">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>effectiveness</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">extent to which planned activities are realized and planned results achieved</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>результативность</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-021">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>event</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">occurrence or change of a particular set of circumstances</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>событие</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-022">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>external context</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">external environment in which the organization seeks to achieve its objectives</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>внешний контекст</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-023">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>governance of information security</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">system by which an organization's information security activities are directed and controlled</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>управление информационной безопасностью</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-024">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>governing body</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">person or group of people who are accountable for the performance and conformity of the organization</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>руководящий орган управления</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-025">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>indicator</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">measure that provides an estimate or evaluation</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>индикатор</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-026">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>information need</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">insight necessary to manage objectives, goals, risks and problems</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>информационная потребность</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-027">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>information processing facilities</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">any information processing system, service or infrastructure, or the physical location housing it</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>средства обработки информации</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-028">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>information security</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">preservation of confidentiality, integrity and availability of information</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>информационная безопасность</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-029">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>information security continuity</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">processes and procedures for ensuring continued information security operations</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>непрерывность информационной безопасности</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-030">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>information security event</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">identified occurrence of a system, service or network state indicating a possible breach of information security policy or failure of controls</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>событие информационной безопасности</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-031">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>information security incident</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">single or a series of unwanted or unexpected information security events that have a significant probability of compromising business operations</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>инцидент информационной безопасности</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-032">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>information security incident management</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">set of processes for detecting, reporting, assessing, responding to, dealing with, and learning from information security incidents</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>менеджмент инцидентов информационной безопасности</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-033">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>information security management system professional</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">person who establishes, implements, maintains and continuously improves one or more information security management system processes</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>профессионал системы менеджмента информационной безопасности</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-034">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>information sharing community</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">group of organizations that agree to share information</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>сообщество обмена информацией</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-035">
        <descrip type="subjectField">Кибербезопасность и защита информации</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>information system</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">set of applications, services, information technology assets, or other information-handling components</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
